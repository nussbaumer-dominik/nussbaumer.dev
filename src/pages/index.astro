---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import About from '../components/About.astro';
import Work from '../components/Work.astro';
import Projects from '../components/Projects.astro';
import Footer from '../components/Footer.astro';
import Education from "../components/Education.astro";
import Connect from "../components/Connect.astro";
---

<Layout>
    <div class="flex flex-col min-h-screen max-w-2xl mx-auto pt-12 px-4 lg:px-8">
        <div class="motion-preset-slide-up-md motion-duration-500">
            <Header/>
        </div>
        <main class="grow">
            <div class="motion-preset-slide-up-md motion-duration-500 motion-delay-100">
                <About/>
            </div>
            <div class="motion-preset-slide-up-md motion-duration-500 motion-delay-200">
                <Projects/>
            </div>
            <div class="motion-preset-slide-up-md motion-duration-500 motion-delay-300">
                <Work/>
            </div>
            <div class="motion-preset-slide-up-md motion-duration-500 motion-delay-400">
                <Education/>
            </div>
            <div class="motion-preset-slide-up-md motion-duration-500 motion-delay-500">
                <Connect/>
            </div>
        </main>
        <div class="mt-auto motion-preset-slide-up-md motion-duration-500 motion-delay-[600ms]">
            <Footer/>
        </div>
    </div>
</Layout>