---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import About from '../components/About.astro';
import Work from '../components/Work.astro';
import Projects from '../components/Projects.astro';
import Footer from '../components/Footer.astro';
import Education from "../components/Education.astro";
---

<Layout>
    <div class="flex flex-col min-h-screen max-w-2xl mx-auto pt-12 px-4 lg:px-8">
        <div class="motion-preset-slide-up-md motion-duration-1000" transition:name="Header" transition:persist>
            <Header/>
        </div>
        <main class="flex-grow">
            <div class="motion-preset-slide-up-md motion-duration-1000 motion-delay-[150ms]">
                <About/>
            </div>
            <div class="motion-preset-slide-up-md motion-duration-1000 motion-delay-[300ms]">
                <Work/>
            </div>
            <div class="motion-preset-slide-up-md motion-duration-1000 motion-delay-[450ms]">
                <Projects/>
            </div>
            <div class="motion-preset-slide-up-md motion-duration-1000 motion-delay-[600ms]">
                <Education/>
            </div>
        </main>
        <div class="mt-auto motion-preset-slide-up-md motion-duration-1000 motion-delay-400" transition:name="Footer" transition:persist>
            <Footer/>
        </div>
    </div>
</Layout>