---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import SectionElement from "../components/SectionElement.astro";
import Header from "../components/Header.astro";
---
<Layout url="https://nussbaumer.dev/imprint/">
    <div class="flex flex-col min-h-screen max-w-2xl mx-auto pt-12 px-4 lg:px-8">
        <div class="motion-preset-slide-up-md motion-duration-1000" transition:name="Header" transition:persist>
            <Header/>
        </div>
        <main class="motion-preset-slide-up-md motion-duration-1000 motion-delay-200">
            <h2 class="text-2xl font-semibold mb-8">Imprint</h2>

            <div class="space-y-6">
                <SectionElement title="GENERAL">
                    <p class="text-gray-900">
                        Dominik Nussbaumer<br/>
                        Feldgasse 22<br/>
                        3422 Hadersfeld<br/>
                        Austria
                    </p>
                </SectionElement>
                <SectionElement title="CONTACT">
                    <p class="text-gray-900">
                        Email: dominik@nussbaumer.dev
                    </p>
                </SectionElement>

                <SectionElement title="DISPUTES">
                    <p class="text-gray-900">
                        The European Commission provides a platform for online dispute resolution (OS):
                        <a href="https://ec.europa.eu/consumers/odr/" class="text-blue-600 hover:underline ml-1"
                           target="_blank"
                           rel="noopener noreferrer">
                            https://ec.europa.eu/consumers/odr/
                        </a>
                    </p>
                </SectionElement>
            </div>
        </main>
        <div class="mt-auto motion-preset-slide-up-md motion-duration-1000 motion-delay-400" transition:name="Footer" transition:persist>
            <Footer/>
        </div>
    </div>
</Layout>