---
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Add SEO tags, favicon, etc. -->
  </head>
  <body class="min-h-screen bg-white text-gray-800">
    <slot />
  </body>
</html>