---
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="description" content="Dominik Nussbaumer | Full Stack Engineer based in Austria, who loves the Web and is interested in clean design.">
    <meta name="keywords" content="Dominik Nussbaumer, Personal Portfolio, Full Stack Engineer, Developer, Angular, HTML, CSS, Javascript, Java, Kotlin, Microservices, Kubernetes, Bachelor of Science, Computer Science, Software Engineering">
    <meta name="author" content="Dominik Nussbaumer">
    <!-- Add SEO tags, favicon, etc. -->
    <script defer data-domain="nussbaumer.dev" src="https://analytics.spritkenig.com/js/script.js" />
    <!-- ADD Cookiebanner component and only add script if ok -->
  </head>
  <body class="min-h-screen bg-white text-gray-800">
    <slot />
  </body>
</html>