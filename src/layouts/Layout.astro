---
import {SEO} from "astro-seo"
import "../styles/base.css";
import {ScreenSize} from "../components/ScreenSize";

interface Props {
  title?: string,
  url?: string,
  children?: any,
}

const {
  title = "Dominik Nussbaumer | Full Stack Engineer",
  url = "https://nussbaumer.dev"
} = Astro.props;
const meta = {
  title: title,
  author: "Dominik Nussbaumer",
  url: url,
  description: "Dominik Nussbaumer | Full Stack Engineer based in Austria, who loves the Web and is interested in clean design.",
  keywords: "Dominik Nussbaumer, Personal Portfolio, Full Stack Engineer, Developer, Angular, HTML, CSS, Javascript, Java, Kotlin, Microservices, Kubernetes, Bachelor of Science, Computer Science, Software Engineering",
  ogType: "website",
  image: "https://nussbaumer.dev/nussbaumer-og.png",
  imageAlt: "Dominik Nussbaumer Logo"
}

const isProd = import.meta.env.PROD;
const isDev = import.meta.env.DEV;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <SEO
            title={meta.title}
            description={meta.description}
            canonical={meta.url}
            charset="UTF-8"
            openGraph={{
              basic: {
                title: meta.title,
                type: meta.ogType,
                url: meta.url,
                image: meta.image,
              },
              image: {
                url: meta.image,
                width: 1200,
                height: 600,
                alt: meta.imageAlt,
              },
              optional: {
                description: meta.description,
                locale: "en",
              }
            }}
            twitter={{
              creator: "Do_Nuss",
              card: "summary_large_image",
              description: meta.description,
              title: meta.title,
              site: "@Do_Nuss",
              image: meta.image,
              imageAlt: meta.imageAlt,
            }}
    />
    <meta name="author" content={meta.author}/>
    <meta property="og:site-name" content="nussbaumer.dev"/>
    <meta name="keywords" content={meta.keywords}/>
    <link rel="sitemap" href="/sitemap-index.xml"/>

    <!-- ADD Cookiebanner component and only add script if ok -->
    <link rel="icon" href="/favicon/favicon.ico" sizes="32x32"/>
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png"/>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png"/>
    <link rel="shortcut icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png"/>
    <link rel="manifest" href="/favicon/site.webmanifest"/>
  {isProd && <script is:inline
      async
      src="https://stats.home.nussbaumer.dev/script.js"
      data-website-id="e1363121-eee2-4702-9ea9-93db20be368c"/>}
</head>
<body class="min-h-screen bg-white text-gray-800">
<!--
THESIS: A proof desk for a full-stack engineer — finished work as evidence, refusing the splash-hero portfolio arrangement.
OWN-WORLD: White canvas, graphite ink, hairline rules, native sans at a small scale; green, blue, yellow, and red only as named states; flat, no shadows.
STORY: A recruiter reads one positioning line, sees finished products with problem, role, decisions, and outcome, and acts via selected work or the resume.
FIRST VIEWPORT: Name and availability on top; positioning paragraph; primary "View selected work" and secondary resume/LinkedIn actions above the fold; first evidence directly beneath.
FORM: Extension of the committed Proof Desk world (DESIGN.md); incumbent identity inherited, no concept roll.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->
<a href="#main"
   class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:px-3 focus:py-2 focus:rounded-lg focus:border focus:border-gray-300 text-sm font-medium">
    Skip to content
</a>
<slot/>
{isDev &&
        <ScreenSize client:load/>}
</body>
</html>