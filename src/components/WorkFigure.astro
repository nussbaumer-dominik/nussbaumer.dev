---
import fs from "node:fs";
import { fileURLToPath } from "node:url";

interface Props {
    slug: string;
    alt: string;
}

const { slug, alt } = Astro.props;

// Renders the real screenshot when public/work/<slug>.<ext> exists at build
// time; otherwise an honest, labeled slot naming the exact file to add.
const extensions = ["webp", "png", "jpg"];
const found = extensions.find((ext) =>
    fs.existsSync(fileURLToPath(new URL(`../../public/work/${slug}.${ext}`, import.meta.url)))
);
---
{found ? (
        <img
                src={`/work/${slug}.${found}`}
                alt={alt}
                class="w-full aspect-[16/10] object-cover object-top rounded-lg border border-gray-200"
                width="1280"
                height="800"
                loading="lazy"
                decoding="async"
        />
) : (
        <div
                class="w-full aspect-[16/10] rounded-lg border border-gray-200 flex flex-col items-center justify-center gap-2"
                role="img"
                aria-label={`${alt} — screenshot pending`}
        >
            <p class="flex items-center gap-2 text-sm font-medium text-gray-600">
                <span class="inline-block w-2 h-2 rounded-full bg-yellow-400" aria-hidden="true"></span>
                Screenshot pending
            </p>
            <p class="text-sm text-gray-500">add <code class="text-gray-600">public/work/{slug}.webp</code></p>
        </div>
)}
