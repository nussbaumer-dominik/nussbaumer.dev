---
import SectionElement from "./SectionElement.astro";
import { ArrowUpRight } from "lucide-astro";

const projects = [
    {
        title: "Distributed Systems Technologies",
        description: "Modular Java solutions for the DST course at TU Wien — Maven builds, JUnit-tested, containerized.",
        meta: "Java · Maven · Docker",
        href: "https://github.com/nussbaumer-dominik/dst23",
        linkLabel: "Source",
    },
    {
        title: "Full-stack payment app",
        description: "Course project with React, Spring Boot, and MongoDB; GitLab CI with security scanning. Team of three, main contributor.",
        meta: "React · Spring Boot · MongoDB",
        href: "https://github.com/nussbaumer-dominik/waecm",
        linkLabel: "Source",
    },
    {
        title: "nussbaumer.dev",
        description: "This site: statically generated, no client-side framework on the page you are reading.",
        meta: "Astro · Tailwind CSS",
        href: "/colophon",
        linkLabel: "Colophon",
    },
];
---
<SectionElement title="PROJECTS">
    <ul>
        {projects.map((project, index) => (
                <li class:list={["py-4", { "border-t border-gray-200": index > 0 }]}>
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                        <h3 class="font-semibold text-gray-900">{project.title}</h3>
                        <a
                                href={project.href}
                                target={project.href.startsWith("http") ? "_blank" : undefined}
                                rel={project.href.startsWith("http") ? "noopener noreferrer" : undefined}
                                class="inline-flex items-center gap-0.5 text-sm font-medium text-blue-600 hover:underline underline-offset-4"
                        >
                            {project.linkLabel}<ArrowUpRight class="w-4 h-4" aria-hidden="true"/>
                            {project.href.startsWith("http") && <span class="sr-only">(opens in a new tab)</span>}
                        </a>
                    </div>
                    <p class="mt-1 text-gray-800">{project.description}</p>
                    <p class="mt-1 text-sm text-gray-500">{project.meta}</p>
                </li>
        ))}
    </ul>
    <p class="mt-2 text-gray-800">
        More on
        <a
                href="https://github.com/nussbaumer-dominik"
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-blue-600 hover:underline underline-offset-4"
        >GitHub<span class="sr-only"> (opens in a new tab)</span></a>.
    </p>
</SectionElement>
