---
const {title, isMobile, id} = Astro.props
---
<section id={id} class:list={["mb-10 lg:relative scroll-mt-12", {"md:flex": isMobile}]}>
    <h2
            class:list={[
                "text-sm font-semibold text-gray-500 mb-4 lg:mb-0",
                {"hidden lg:block absolute": isMobile},
                {"static lg:absolute": !isMobile}
            ]} style="left:-20%"
    >
        {title}
    </h2>
    <slot/>
</section>
